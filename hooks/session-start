#!/usr/bin/env bash
# SessionStart hook for the soltero-skills plugin: injects the skill-first
# bootstrap and lean-pipeline routing (hooks/session-context.md) into every
# new session. Emission format follows the superpowers plugin's session-start
# (MIT, © 2025 Jesse Vincent), including the printf-not-heredoc workaround.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

context_content=$(cat "${SCRIPT_DIR}/session-context.md" 2>&1 \
  || echo "Error reading soltero-skills session context")

# Escape for JSON embedding — single-pass parameter substitutions.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

session_context=$(escape_for_json "$context_content")

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # SDK-standard fallback (Copilot CLI and others)
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
