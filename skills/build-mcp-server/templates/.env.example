# Copy to .env and fill in. NEVER commit the real .env.
PORT=8080
BIND_HOST=127.0.0.1
# Required when BIND_HOST is non-localhost (e.g. 0.0.0.0 behind a TLS proxy). Comma-separated.
# ALLOWED_HOSTS=mcp.example.com
# Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=
LOG_LEVEL=info
