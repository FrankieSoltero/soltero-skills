# Copy to .env.local (or .env) and fill in. NEVER commit real secrets — keep .env* gitignored.
# Mirror every variable in env.ts here so onboarding and CI know what's required.

NODE_ENV=development

# Server-only secrets (no public prefix — never sent to the client):
# DATABASE_URL=

# Client-exposed (prefix required, value is PUBLIC):
#   Next.js NEXT_PUBLIC_*  |  Vite VITE_*  |  Astro PUBLIC_*  |  Expo EXPO_PUBLIC_*
# NEXT_PUBLIC_API_URL=
